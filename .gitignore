# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.env

# Large data & model artifacts — NEVER commit these (datasets/ alone is >200 GB).
# Accidentally staging them refills the disk with multi-GB git temp packs.
datasets/
checkpoints/
runs/
*.pt
*.pth
*.ckpt
*.safetensors
*.mp4
*.avi
*.mov

# The mlflow store is NOT regenerable — reproducing its 177 runs is weeks of GPU — but the
# binary db cannot be pushed: GitHub's secret scanner reads a 32-hex mlflow run_uuid that
# happens to follow the bytes "AC" in a sqlite page as a Twilio Account SID. So the RUNS
# are tracked as CSV in mlflow_export/ (regenerate with pour_probe/mlflow_export.py) and
# the logged artifacts as mlruns/. Keep the db itself local.
mlflow.db

# Experiment artifacts & caches (regenerable)
egoper_probe/features/
exprt_probe/features/
exprt_probe/pooled/
exprt_probe/pooled_mean/
exprt_probe/pooled_rand/
video_qa/data/

# QC / diagnostic images — regenerated on every viz run, pure noise in git status
qc_*.png
qc_*.pdf
**/qc/
# …except the curated copies the slide deck actually renders (synced by make_figs.py)
!presentation/assets/qc_*.png

# External reference repos cloned for reading only (each has its own .git)
third_party/

# Regenerable per-video OCR output (final dataset lives on the NAS; the human-verified
# corrections in clip_split/ocr_overrides.json + annotations.json ARE tracked)
pouring/clip_split/ocr/

# Course material (not ours to redistribute)
datasets.pdf

# uv init boilerplate (unused)
main.py

# Separate tooling / node deps
OverleafMCP/
node_modules/

# Notebook checkpoints
.ipynb_checkpoints/
